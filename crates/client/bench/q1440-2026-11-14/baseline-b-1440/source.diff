+#[test]
+fn paced_two_viewer_video_keeps_every_one_second_bin_without_inventing_probe_loss() {
+    let mut n = Network::new(32_000_000);
+    let a = n.add(true);
+    let b = n.add(false);
+    let c = n.add(false);
+    n.subscribe(b, a, TrackKind::Screen);
+    n.subscribe(c, a, TrackKind::Screen);
+    n.clear();
+    let before_bytes = n.video_bytes;
+    let mut sequence = 1;
+    // A deterministic RTP transport regression, NOT hardware video acceptance.
+    // ~11.6 Mbps payload with a 130 KB IDR each second, over sixty simulated
+    // seconds so allocation/ALR probes and sequence rollover are exercised.
+    for second in 0..60 {
+        let before = [n.peers[b].frames, n.peers[c].frames];
+        for frame in 0..60 {
+            let keyframe = frame == 0;
+            let packets = if keyframe { 110 } else { 19 };
+            for packet in 0..packets {
+                let mut payload = vec![7; 1180];
+                payload[0] = 0x7c;
+                let kind = if keyframe { 5 } else { 1 };
+                payload[1] = kind
+                    | if packet == 0 {
+                        0x80
+                    } else if packet + 1 == packets {
+                        0x40
+                    } else {
+                        0
+                    };
+                n.send(
+                    a,
+                    TrackKind::Screen,
+                    sequence,
+                    9000 + (second * 60 + frame) * 1500,
+                    &payload,
+                    packet + 1 == packets,
+                );
+                sequence += 1;
+            }
+            n.advance(Duration::from_micros(16_667));
+        }
+        for (viewer, previous) in [(b, before[0]), (c, before[1])] {
+            let frames = n.peers[viewer].frames - previous;
+            assert!(
+                frames >= 45,
+                "viewer {viewer} simulated bin {second}: {frames} fps"
+            );
+            n.peers[viewer].events.clear();
+        }
+    }
+    for viewer in [b, c] {
+        assert!(n.peers[viewer].frames >= 3480);
+        assert!(n
+            .signals
+            .iter()
+            .any(|(peer, event)| *peer == n.peers[viewer].key
+                && matches!(event, VoiceEvent::Stats(_))));
+    }
+    assert!(n.signals.iter().all(|(_, event)| !matches!(event,
+        VoiceEvent::Stats(stats) if stats.queue_dropped_packets != 0 || stats.cap_dropped_packets != 0)));
+    assert!(n.video_bytes - before_bytes <= 32_000_000 / 8 * 601 / 10);
+}
