+#[test]
+fn two_viewers_drain_a_fragmented_1440p_idr_without_guard_reset() {
+    let mut n = Network::new(32_000_000);
+    let a = n.add(true);
+    let b = n.add(false);
+    let c = n.add(false);
+    n.subscribe(b, a, TrackKind::Screen);
+    n.subscribe(c, a, TrackKind::Screen);
+    n.clear();
+    // The negotiated fixture estimate is 12 Mbps: 295 KB drains within
+    // 250 ms, while 413/590 KB do not. Keep this above the old 256 KiB
+    // guard without asserting that an impossible oversized burst must fit.
+    // One 295 KB FU-A IDR at a single instant, followed by normal delta
+    // frames. Exercises actual SRTP, str0m pacing, both fair wire buckets and
+    // the guard, rather than just testing a larger numeric threshold.
+    for seq in 1..=250 {
+        let mut payload = vec![7; 1180];
+        payload[0] = 0x7c;
+        payload[1] = if seq == 1 {
+            0x85
+        } else if seq == 250 {
+            0x45
+        } else {
+            0x05
+        };
+        n.send(a, TrackKind::Screen, seq, 9000, &payload, seq == 250);
+    }
+    for frame in 1..=60 {
+        n.advance(Duration::from_micros(16_667));
+        let mut payload = vec![7; 1180];
+        payload[0] = 0x41;
+        n.send(
+            a,
+            TrackKind::Screen,
+            250 + frame,
+            9000 + frame as u32 * 1500,
+            &payload,
+            true,
+        );
+    }
+    for receiver in [b, c] {
+        let fragments = n.peers[receiver]
+            .events
+            .iter()
+            .filter(|event| matches!(event, Event::RtpPacket(p) if p.header.timestamp == 9000))
+            .count();
+        assert_eq!(
+            fragments, 250,
+            "viewer {receiver} lost part of its startup IDR"
+        );
+    }
+    assert!(n.signals.iter().all(|(_, event)| !matches!(event,
+        VoiceEvent::Stats(stats) if stats.queue_dropped_packets != 0)));
+    // Even dropped padding creates missing transport sequence numbers and
+    // false congestion feedback. Admit it before dequeue, not poll-and-drop.
+    assert!(n.signals.iter().all(|(_, event)| !matches!(event,
+        VoiceEvent::Stats(stats) if stats.cap_dropped_packets != 0)));
+    assert!(n.max_rtp <= 1232);
+}
