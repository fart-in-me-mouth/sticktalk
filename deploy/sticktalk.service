[Unit]
Description=StickTalk chat server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sticktalk
Group=sticktalk
StateDirectory=sticktalk
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sticktalk
Environment=STICKTALK_BIND=127.0.0.1:8080
Environment=STICKTALK_DATA_DIR=/var/lib/sticktalk
Environment=STICKTALK_MAX_UPLOAD_MB=0
Environment=RUST_LOG=sticktalk_server=info
EnvironmentFile=-/etc/sticktalk.env
ExecStart=/usr/local/bin/sticktalk-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=128
MemoryHigh=768M
MemoryMax=1G
LimitNOFILE=8192
ReadWritePaths=/var/lib/sticktalk

[Install]
WantedBy=multi-user.target
