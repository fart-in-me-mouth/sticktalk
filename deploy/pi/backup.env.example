# Private off-device rsync destination on Tailscale, with SSH keys/host key set up.
BACKUP_DEST=backup@backup-pc.your-tailnet.ts.net:/srv/backups/sticktalk
BACKUP_KEY=/root/.ssh/sticktalk-backup

# PUBLIC recipient only. Keep the AGE-SECRET-KEY off this Pi and the backup host.
BACKUP_RECIPIENT=age1REPLACE_WITH_OWNER_PUBLIC_RECIPIENT
