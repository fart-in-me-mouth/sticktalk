[Unit]
Description=StickTalk chat server
After=network-online.target tailscaled.service
Wants=network-online.target
RequiresMountsFor=/srv/sticktalk
ConditionPathIsMountPoint=/srv/sticktalk

[Service]
User=sticktalk
Group=sticktalk
WorkingDirectory=/srv/sticktalk/data
EnvironmentFile=/etc/sticktalk/server.env
ExecStart=/usr/local/bin/sticktalk-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sticktalk/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
