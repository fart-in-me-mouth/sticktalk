STICKTALK_BIND=127.0.0.1:8080
STICKTALK_DATA_DIR=/srv/sticktalk/data
STICKTALK_PUBLIC_URL=https://REPLACE.your-tailnet.ts.net
STICKTALK_MAX_UPLOAD_MB=0
STICKTALK_MIN_FREE_DISK_GB=10
STICKTALK_USER_QUOTA_MB=0
STICKTALK_MAX_TOTAL_UPLOAD_MB=0
# STICKTALK_GOOGLE_CLIENT_ID=optional-public-desktop-client-id
# STICKTALK_UPDATE_PUBLIC_KEY=base64-32-byte-public-key
# STICKTALK_RELEASE_TOKEN=separate-random-token-at-least-32-characters
# ICE media bypasses Caddy. Installer substitutes the assigned Tailscale IP.
STICKTALK_VOICE_BIND_IP=REPLACE_TAILSCALE_IP
# Omit advertised IP to auto-detect an assigned 100.64/10 Tailscale address.
# STICKTALK_VOICE_ADVERTISED_IP=100.64.0.2
STICKTALK_VOICE_UDP_PORT_START=50000
STICKTALK_VOICE_UDP_PORT_END=50100
STICKTALK_VOICE_EGRESS_BPS=32000000
STICKTALK_VOICE_MAX_DATAGRAM_BYTES=1232
RUST_LOG=sticktalk_server=info
