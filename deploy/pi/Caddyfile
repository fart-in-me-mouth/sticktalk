{
	servers {
		max_header_size 32KB
		timeouts {
			read_header 10s
			read_body 120s
			write 15m
			idle 2m
		}
	}
	auto_https disable_redirects
}

https://{$STICKTALK_HOST} {
	bind {$STICKTALK_TAILSCALE_IP}
	tls /etc/caddy/sticktalk.crt /etc/caddy/sticktalk.key
	@chat path /api/v1/ws
	reverse_proxy @chat 127.0.0.1:8080
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
		transport http {
			dial_timeout 3s
			response_header_timeout 15m
			read_timeout 30s
			write_timeout 30s
		}
	}
	# No access logs: attachment URLs can contain private identifiers.
}
