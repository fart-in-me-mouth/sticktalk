{
	servers {
		max_header_size 32KB
		timeouts {
			read_header 10s
			read_body 120s
			write 15m
			idle 2m
		}
	}
}

# Replace this hostname with your own DuckDNS hostname BEFORE reloading.
YOUR-NAME.duckdns.org {
	# TLS issuance/renewal, HTTP redirects, and WS upgrades are automatic.
	@chat path /api/v1/ws
	reverse_proxy @chat 127.0.0.1:8080
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 15m
			read_timeout 30s
			write_timeout 30s
		}
	}
	# No access log: auth and private data must not be logged.
	header Strict-Transport-Security "max-age=31536000"
}
